library(haven)
library(dplyr)
library(stringi)
library(tidyr)
library(ggplot2)
# Clean string function for fuzzy matching
clean_string <- function(s) {
s <- tolower(s)
s <- stri_trans_general(s, "Latin-ASCII")
s <- gsub("[^a-z0-9]", "", s)
return(s)
}
# Clean numeric character columns
clean_num <- function(x) {
x <- as.character(x)
x <- gsub(",", "", x)
x <- gsub(" ", "", x)
x[x == "" | x == "-" | grepl("-0", x)] <- "0"
x <- as.numeric(x)
x[is.na(x)] <- 0
return(x)
}
cat("=== 1. LOADING ELECTORAL DATA ===\n")
df_elec <- read.csv("data/electoral/processed/municipio_switching/petro_switching.csv")
df_elec$dane_code <- sprintf("%05d", as.integer(df_elec$dane_code))
cat("\n=== 2. PROCESSING COAL MINING DATA (ANM) ===\n")
minerals_file <- "data/energy_mining/all_minerals/ANM_Volu%CC%81men_de_Explotacio%CC%81n_de_Minerales_Asociados_a_Pagos_de_Regali%CC%81as_20260702.csv"
if (!file.exists(minerals_file)) {
minerals_file <- "data/energy_mining/all_minerals/ANM_Volúmen_de_Explotación_de_Minerales_Asociados_a_Pagos_de_Regalías_20260702.csv"
}
min_data <- read.csv(minerals_file)
coal_data <- min_data %>%
filter(grepl("carbon", Recurso.Natural, ignore.case = TRUE) &
!grepl("carbonato", Recurso.Natural, ignore.case = TRUE))

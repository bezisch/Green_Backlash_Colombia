library(dplyr)
library(readr)
library(stringr)
# Function to read and aggregate mesa data
process_mesas <- function(file_path) {
cat("Reading file:", file_path, "\n")
df <- read_delim(
file_path,
delim = ";",
locale = locale(encoding = "latin1"),
col_types = cols(.default = "c"),
show_col_types = FALSE
)
cat("Raw rows count:", nrow(df), "\n")
aggregated <- df %>%
mutate(
votos_num = as.numeric(VOTOS),
COD_DDE = str_pad(DEP, 2, pad = "0"),
COD_MME = str_pad(MUN, 3, pad = "0"),
DES_DD = trimws(DEPNOMBRE),
DES_MM = trimws(MUNNOMBRE),
DES_CAN = trimws(sub("\\s*\\.$", "", CANNOMBRE))
) %>%
group_by(COD_DDE, DES_DD, COD_MME, DES_MM, DES_CAN) %>%
summarise(votes = sum(votos_num, na.rm = TRUE), .groups = "drop") %>%
select(COD_DDE, DES_DD, COD_MME, DES_MM, DES_CAN, votes)
cat("Aggregated rows count:", nrow(aggregated), "\n")
return(aggregated)
}
# Determine script base path dynamically
base_dir <- getwd()
path_1v <- file.path(base_dir, "data/electoral/raw/primera_vuelta_mesas_2022/MMV_NACIONAL_PRESIDENTE_2022_1v.csv")
path_2v <- file.path(base_dir, "data/electoral/raw/segunda_vuelta_mesas_2022/MMV_NACIONAL_PRESIDENTE_2022_2v.csv")
# Process 1st and 2nd round
cat("=== PROCESSING 2022 PRIMERA VUELTA (1ST ROUND) ===\n")
muns_votes_2022_1v <- process_mesas(path_1v)
cat("\n=== PROCESSING 2022 SEGUNDA VUELTA (2ND ROUND) ===\n")
muns_votes_2022_2v <- process_mesas(path_2v)
# Save processed CSV files

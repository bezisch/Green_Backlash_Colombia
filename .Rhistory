"La Guajira" = "LA GUAJIRA", "Magdalena" = "MAGDALENA", "Meta" = "META",
"Narino" = "NARIÑO", "Norte De Santander" = "NORTE DE SAN", "Putumayo" = "PUTUMAYO",
"Quindio" = "QUINDIO", "Risaralda" = "RISARALDA", "Santander" = "SANTANDER",
"Sucre" = "SUCRE", "Tolima" = "TOLIMA", "Valle Del Cauca" = "VALLE",
"Vaupes" = "VAUPES", "Vichada" = "VICHADA"
)
# Using English columns 'department' and 'municipality'
df_elec <- df_elec %>%
mutate(dept_oilgas = dept_map[department], clean_mun = clean_string(municipality))
dept_oilgas_map <- c(
"AMAZONAS" = "AMAZONAS", "ANTIOQUIA" = "ANTIOQUIA", "ARAUCA" = "ARAUCA",
"ATLANTICO" = "ATLANTICO", "BOLIVAR" = "BOLIVAR", "BOYACA" = "BOYACA",
"CALDAS" = "CALDAS", "CAQUETA" = "CAQUETA", "CASANARE" = "CASANARE",
"CAUCA" = "CAUCA", "CESAR" = "CESAR", "CHOCO" = "CHOCO", "CORDOBA" = "CORDOBA",
"CUNDINAMARCA" = "CUNDINAMARCA", "GUAINIA" = "GUAINIA", "GUAVIARE" = "GUAVIARE",
"HUILA" = "HUILA", "GUAJIRA" = "LA GUAJIRA", "LA GUAJIRA" = "LA GUAJIRA",
"MAGDALENA" = "MAGDALENA", "META" = "META", "NARIÑO" = "NARIÑO",
"NORTE DE SANTANDER" = "NORTE DE SAN", "NORTE DE SAN" = "NORTE DE SAN",
"PUTUMAYO" = "PUTUMAYO", "QUINDIO" = "QUINDIO", "RISARALDA" = "RISARALDA",
"SAN ANDRES" = "SAN ANDRES", "SANTANDER" = "SANTANDER", "SUCRE" = "SUCRE",
"TOLIMA" = "TOLIMA", "VALLE" = "VALLE", "VALLE DEL CAUCA" = "VALLE",
"VAUPES" = "VAUPES", "VICHADA" = "VICHADA"
)
oil_gas_summary <- oil_gas_summary %>%
mutate(
dept_mapped = dept_oilgas_map[Departamento],
clean_mun = clean_string(Municipio)
) %>%
filter(!is.na(dept_mapped))
# Match using department and exact name mapping
exact_matches <- df_elec %>%
inner_join(oil_gas_summary, by = c("dept_oilgas" = "dept_mapped", "clean_mun" = "clean_mun")) %>%
mutate(match_type = "exact")
# Unmatched
unmatched_elec <- df_elec %>%
filter(!dane_code %in% exact_matches$dane_code)
unmatched_oilgas <- oil_gas_summary %>%
filter(!paste(dept_mapped, clean_mun) %in% paste(exact_matches$dept_oilgas, exact_matches$clean_mun))
# Fuzzy match unmatched
fuzzy_matches <- list()
for (i in seq_len(nrow(unmatched_oilgas))) {
row_og <- unmatched_oilgas[i, ]
dept <- row_og$dept_mapped
c_mun_og <- row_og$clean_mun
candidates_elec <- unmatched_elec %>% filter(dept_oilgas == dept)
if (nrow(candidates_elec) > 0) {
# Substring match
sub_idx <- NA
for (j in seq_len(nrow(candidates_elec))) {
c_mun_el <- candidates_elec$clean_mun[j]
if (grepl(c_mun_og, c_mun_el) || grepl(c_mun_el, c_mun_og)) {
sub_idx <- j
break
}
}
# We only accept fuzzy matches if they are actually close (Levenshtein distance <= 4)
# to avoid false matches
if (!is.na(sub_idx)) {
dist_val <- as.vector(adist(c_mun_og, candidates_elec$clean_mun[sub_idx]))
if (dist_val <= 4) {
fuzzy_matches[[length(fuzzy_matches) + 1]] <- bind_cols(candidates_elec[sub_idx, ], row_og) %>%
mutate(match_type = "substring")
}
} else {
# Levenshtein distance
dists <- as.vector(adist(c_mun_og, candidates_elec$clean_mun))
best_idx <- which.min(dists)
best_dist <- dists[best_idx]
if (best_dist <= 3) {
fuzzy_matches[[length(fuzzy_matches) + 1]] <- bind_cols(candidates_elec[best_idx, ], row_og) %>%
mutate(match_type = "levenshtein")
}
}
}
}
fuzzy_df <- bind_rows(fuzzy_matches)
# Combine
all_matched_og <- bind_rows(
exact_matches %>% select(dane_code, oil_prod_avg, oil_reg_avg, gas_prod_avg, gas_reg_avg),
fuzzy_df %>% select(dane_code, oil_prod_avg, oil_reg_avg, gas_prod_avg, gas_reg_avg)
)
cat("\n=== 4. PROCESSING SOLAR PROJECTS DATA (XM) ===\n")
solar_file <- "data/energy_mining/solar/Proyectos de generación solar (XM).csv"
if (!file.exists(solar_file)) {
solar_file <- "data/energy_mining/solar/Proyectos de generación solar (XM).csv"
}
solar_data <- read.csv(solar_file, sep = ";")
solar_active <- solar_data %>%
filter(Estado.del.recurso %in% c("OPERACIÓN", "PRUEBAS"))
solar_active$capacity_mw <- as.numeric(gsub(",", ".", as.character(solar_active$Capacidad.efectiva.neta..MW.)))
solar_active$capacity_mw[is.na(solar_active$capacity_mw)] <- 0
solar_active$dane_code_str <- sprintf("%05d", as.integer(solar_active$Código.del.municipio))
solar_summary <- solar_active %>%
group_by(dane_code = dane_code_str) %>%
summarize(
solar_capacity_mw = sum(capacity_mw, na.rm = TRUE),
solar_projects_count = n(),
.groups = "drop"
) %>%
mutate(has_solar = ifelse(solar_capacity_mw > 0, 1, 0))
cat("\n=== 5. MERGING ALL DATASETS ===\n")
final_df <- df_elec %>%
left_join(coal_summary, by = "dane_code") %>%
left_join(all_matched_og, by = "dane_code") %>%
left_join(solar_summary, by = "dane_code")
# Fill NAs
final_df$coal_royalties_avg[is.na(final_df$coal_royalties_avg)] <- 0
final_df$coal_volume_avg[is.na(final_df$coal_volume_avg)] <- 0
final_df$has_coal_mining[is.na(final_df$has_coal_mining)] <- 0
final_df$oil_prod_avg[is.na(final_df$oil_prod_avg)] <- 0
final_df$oil_reg_avg[is.na(final_df$oil_reg_avg)] <- 0
final_df$gas_prod_avg[is.na(final_df$gas_prod_avg)] <- 0
final_df$gas_reg_avg[is.na(final_df$gas_reg_avg)] <- 0
final_df$solar_capacity_mw[is.na(final_df$solar_capacity_mw)] <- 0
final_df$has_solar[is.na(final_df$has_solar)] <- 0
final_df <- final_df %>%
mutate(
has_oil_gas = ifelse(oil_prod_avg > 0 | gas_prod_avg > 0, 1, 0),
oil_gas_royalties_avg = oil_reg_avg + gas_reg_avg
)
cat("\n=== 6. COMPUTING AVERAGES AND COMPARISONS ===\n")
backlash_group <- final_df %>% filter(switched_plurality == TRUE)
national_group <- final_df
# Summary Stats
calc_stats <- function(df_group) {
c(
coal_share = mean(df_group$has_coal_mining),
coal_royalties = mean(df_group$coal_royalties_avg),
oil_gas_share = mean(df_group$has_oil_gas),
oil_gas_royalties = mean(df_group$oil_gas_royalties_avg),
solar_share = mean(df_group$has_solar),
solar_capacity = mean(df_group$solar_capacity_mw)
)
}
stats_backlash <- calc_stats(backlash_group)
stats_national <- calc_stats(national_group)
# T-tests
get_p_value <- function(var_name) {
t_res <- t.test(backlash_group[[var_name]], national_group[[var_name]])
return(t_res$p.value)
}
p_values <- c(
get_p_value("has_coal_mining"),
get_p_value("coal_royalties_avg"),
get_p_value("has_oil_gas"),
get_p_value("oil_gas_royalties_avg"),
get_p_value("has_solar"),
get_p_value("solar_capacity_mw")
)
# English titles and values
summary_table <- data.frame(
Activity = c("Coal", "Coal", "Oil/Gas", "Oil/Gas", "Solar (Renewables)", "Solar (Renewables)"),
Indicator = c(
"% of Municipalities with Mining",
"Average Annual Royalties (COP)",
"% of Producing Municipalities",
"Average Annual Royalties (COP)",
"% of Municipalities with Projects",
"Average Capacity (MW)"
),
Backlash_Avg = stats_backlash,
National_Avg = stats_national,
P_Value = p_values
) %>%
mutate(
Ratio = Backlash_Avg / National_Avg,
Significance = case_when(
P_Value < 0.01 ~ "*** (p < 0.01)",
P_Value < 0.05 ~ "** (p < 0.05)",
P_Value < 0.10 ~ "* (p < 0.10)",
TRUE ~ "Not significant"
)
)
# Format values for printing
summary_formatted <- summary_table %>%
mutate(
Backlash_Avg_Fmt = case_when(
grepl("%", Indicator) ~ sprintf("%.2f%%", Backlash_Avg * 100),
grepl("COP", Indicator) ~ paste0("$", format(round(Backlash_Avg, 2), big.mark = ",", scientific = FALSE)),
TRUE ~ sprintf("%.2f MW", Backlash_Avg)
),
National_Avg_Fmt = case_when(
grepl("%", Indicator) ~ sprintf("%.2f%%", National_Avg * 100),
grepl("COP", Indicator) ~ paste0("$", format(round(National_Avg, 2), big.mark = ",", scientific = FALSE)),
TRUE ~ sprintf("%.2f MW", National_Avg)
),
Ratio_Fmt = sprintf("%.2fx", Ratio)
)
# Print Summary Table
print(summary_formatted %>% select(Activity, Indicator, Backlash_Avg_Fmt, National_Avg_Fmt, Ratio_Fmt, Significance))
# Print Summary Table
print(summary_formatted %>% select(Activity, Indicator, Backlash_Avg_Fmt, National_Avg_Fmt, Ratio_Fmt, Significance))
# Print Summary Table
print(summary_formatted %>% select(Activity, Indicator, Backlash_Avg_Fmt, National_Avg_Fmt, Ratio_Fmt, Significance))
# Save results
table_dir <- "output/tables"
graph_dir <- "output/graphs"
dir.create(table_dir, recursive = TRUE, showWarnings = FALSE)
dir.create(graph_dir, recursive = TRUE, showWarnings = FALSE)
write.csv(summary_table, file.path(table_dir, "energy_backlash_comparison.csv"), row.names = FALSE)
# Generate Markdown table in English
md_content <- c(
"# Summary Table: Relationship between Green Backlash and Energy Activities",
"",
"This table compares the average values of coal, oil/gas, and solar energy variables in municipalities that experienced a political shift (*Green Backlash*, $N=36$) vs. the national average ($N=1034$).",
"",
"| Activity | Indicator | Backlash Average | National Average | Ratio (Backlash / Nat) | Significance (t-test) |",
"| :--- | :--- | :---: | :---: | :---: | :--- |"
)
for (i in 1:nrow(summary_formatted)) {
row <- summary_formatted[i, ]
md_content <- c(
md_content,
sprintf(
"| **%s** | %s | %s | %s | **%s** | *%s* |",
row$Activity, row$Indicator, row$Backlash_Avg_Fmt, row$National_Avg_Fmt, row$Ratio_Fmt, row$Significance
)
)
}
md_content <- c(
md_content,
"",
"> *** p < 0.01; ** p < 0.05; * p < 0.10.",
"",
"### Key Findings:",
"- **Oil and Gas:** Backlash municipalities are **1.37 times more likely** to produce hydrocarbons than the national average.",
"- **Solar:** These municipalities are **1.70 times more likely** to host solar projects, with an installed capacity **2.62 times greater** than the national average.",
"- **Coal:** No strong association with coal mining (0.20x ratio)."
)
